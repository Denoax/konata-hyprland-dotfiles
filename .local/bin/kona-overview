#!/usr/bin/env bash
set -euo pipefail

runtime_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kona-overview"
theme="$HOME/.config/rofi/overview.rasi"
fallback_icon='/usr/share/icons/Papirus/64x64/apps/distributor-logo-archlinux.svg'
mkdir -p "$runtime_root"
exec 9>"$runtime_root/overview.lock"
flock -n 9 || exit 0

# Keep background event captures out while this surface is on screen.
# A failed refresh retains the previous complete thumbnail and existing fallback.
"$HOME/.local/bin/kona-workspace-capture" --visible || true

clients="$(hyprctl clients -j)"

menu="$runtime_root/menu"
: > "$menu"
for workspace in {1..10}; do
  count="$(jq --argjson workspace "$workspace" '[.[] | select(.mapped == true and .workspace.id == $workspace)] | length' <<< "$clients")"
  history="$runtime_root/workspace-$workspace.png"
  icon="$history"
  [[ -s "$icon" ]] || icon="$fallback_icon"
  printf 'Workspace %s  ·  %s app%s\0icon\x1f%s\n' \
    "$workspace" "$count" "$([[ "$count" == 1 ]] || printf S)" "$icon" >> "$menu"
done

if [[ "${1:-}" == "--check" ]]; then
  active_thumbnails="$(find "$runtime_root" -maxdepth 1 -type f -name 'workspace-*.png' -size +0c | wc -l)"
  printf 'workspace_cards=10 retained_thumbnails=%s\n' "$active_thumbnails"
  exit 0
fi

choice="$(rofi -dmenu -i -show-icons -p 'Workspaces' \
  -theme "$theme" \
  < "$menu")" || exit 0

workspace="$(sed -n 's/^Workspace \([0-9][0-9]*\).*/\1/p' <<< "$choice")"
if [[ -n "$workspace" ]]; then
  hyprctl dispatch "hl.dsp.focus({ workspace = $workspace })" >/dev/null
  "$HOME/.local/bin/kona-menu-sound"
fi
