#!/usr/bin/env bash
set -euo pipefail

foot="$HOME/.local/opt/kona-pkgs/foot/usr/bin/foot"
if [[ ! -x "$foot" ]]; then
    foot="$(command -v foot || true)"
fi
[[ -n "$foot" ]] || { printf 'Kona terminal: Foot is unavailable; run kona-install-deps.\n' >&2; exit 1; }

exec "$foot" \
    --app-id=KonaTerminal \
    --title='Kona Terminal' \
    "$HOME/.local/bin/kona-scratch-shell" terminal
