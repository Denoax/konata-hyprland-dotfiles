#!/usr/bin/env python3
"""Open Caelestia Nexus with Kona-owned appearance actions."""

from __future__ import annotations

import fcntl
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time


SOURCE = Path("/etc/xdg/quickshell/caelestia")
INTEGRATION_VERSION = b"kona-nexus-wallpaper-owner-v1"


def overlay_root() -> Path:
    return Path(os.environ.get("KONA_CAELESTIA_OVERLAY", Path.home() / ".config/quickshell/kona-caelestia"))


def runtime_root() -> Path:
    return Path.home() / ".cache/kona/caelestia-settings"


def fingerprint() -> str:
    digest = hashlib.sha256()
    digest.update(INTEGRATION_VERSION)
    for path in (
        SOURCE / "shell.qml",
        SOURCE / "modules/nexus/PageRegistry.qml",
        SOURCE / "modules/nexus/PageCompRegistry.qml",
        overlay_root() / "settings-shell.qml",
        overlay_root() / "KonaSettingsWindow.qml",
        overlay_root() / "KonaAppearancePage.qml",
    ):
        digest.update(path.read_bytes())
    return digest.hexdigest()


def stage_runtime() -> Path:
    if not SOURCE.is_dir():
        raise RuntimeError("caelestia-shell is not installed")
    overlay = overlay_root()
    runtime = runtime_root()
    wanted = fingerprint()
    marker = runtime / ".kona-source"
    current = marker.read_text(encoding="utf-8").strip() if marker.is_file() else ""
    if current == wanted:
        return runtime
    if runtime.exists():
        shutil.rmtree(runtime)
    shutil.copytree(SOURCE, runtime)
    shutil.copy2(overlay / "settings-shell.qml", runtime / "shell.qml")
    shutil.copy2(overlay / "KonaSettingsWindow.qml", runtime / "KonaSettingsWindow.qml")
    shutil.copy2(overlay / "KonaAppearancePage.qml", runtime / "modules/nexus/pages/KonaAppearancePage.qml")

    wallpapers = runtime / "services/Wallpapers.qml"
    wallpaper_text = wallpapers.read_text(encoding="utf-8")
    wallpaper_text = wallpaper_text.replace(
        'readonly property string fallback: Quickshell.shellPath("assets/wallpaper.webp")',
        'readonly property string fallback: Quickshell.env("HOME") + "/.local/share/wallpapers/konata-command-center/v2/selected.png"',
        1,
    )
    wallpaper_text = wallpaper_text.replace(
        'Quickshell.execDetached(["caelestia", "wallpaper", "-r", ...smartArg]);',
        'Quickshell.execDetached([Quickshell.env("HOME") + "/.local/bin/kona-wallpaper-select", "--random"]);',
        1,
    )
    wallpaper_text = wallpaper_text.replace(
        'Quickshell.execDetached(["caelestia", "wallpaper", "-f", path, ...smartArg]);',
        'Quickshell.execDetached([Quickshell.env("HOME") + "/.local/bin/kona-wallpaper-select", path]);',
        1,
    )
    wallpaper_text = wallpaper_text.replace(
        'Quickshell.execDetached(["caelestia", "wallpaper", "-f", root.fallback, ...root.smartArg]);',
        '',
    )
    if '"caelestia", "wallpaper", "-f"' in wallpaper_text:
        raise RuntimeError("installed Caelestia wallpaper service changed")
    wallpapers.write_text(wallpaper_text, encoding="utf-8")

    wallpaper_select = runtime / "modules/nexus/pages/wallandstyle/WallpaperSelect.qml"
    select_text = wallpaper_select.read_text(encoding="utf-8")
    select_text = select_text.replace(
        'Quickshell.shellPath("assets/wallpaper.webp")',
        'Quickshell.env("HOME") + "/.local/share/wallpapers/konata-command-center/v2/selected.png"',
    )
    wallpaper_select.write_text(select_text, encoding="utf-8")

    registry = runtime / "modules/nexus/PageRegistry.qml"
    registry_text = registry.read_text(encoding="utf-8")
    registry_text = registry_text.replace('label: qsTr("Wallpaper & style")', 'label: qsTr("Kona appearance")', 1)
    registry_text = registry_text.replace('description: qsTr("Wallpaper, fonts, colours")', 'description: qsTr("Appearance, profiles, wallpaper, motion")', 1)
    registry.write_text(registry_text, encoding="utf-8")

    components = runtime / "modules/nexus/PageCompRegistry.qml"
    component_text = components.read_text(encoding="utf-8")
    old = '''Component {
            // Wallpaper & style
            StackPage {
                Component {
                    WallpaperAndStyle {}
                }
                Component {
                    WallpaperSelect {}
                }
                Component {
                    WallpaperCategory {}
                }
                Component {
                    ColourSelect {}
                }
            }
        },'''
    new = '''Component {
            // Kona keeps appearance/profile/wallpaper state authoritative.
            StackPage {
                Component {
                    KonaAppearancePage {}
                }
                Component {
                    WallpaperSelect {}
                }
                Component {
                    WallpaperCategory {}
                }
            }
        },'''
    if old not in component_text:
        raise RuntimeError("installed Caelestia Nexus page registry changed")
    components.write_text(component_text.replace(old, new, 1), encoding="utf-8")
    marker.write_text(wanted + "\n", encoding="utf-8")
    return runtime


def ipc(executable: str, runtime: Path, method: str) -> bool:
    return subprocess.run(
        [executable, "ipc", "-p", str(runtime), "call", "konaSettings", method],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    ).returncode == 0


def main() -> int:
    try:
        action = sys.argv[1] if len(sys.argv) > 1 else "toggle"
        if action not in ("toggle", "close") or len(sys.argv) > 2:
            raise RuntimeError("usage: kona-caelestia-settings [toggle|close]")
        lock_path = runtime_root().with_suffix(".lock")
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        with lock_path.open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            runtime = stage_runtime()
            executable = shutil.which("quickshell")
            if not executable:
                raise RuntimeError("system quickshell is missing")
            if ipc(executable, runtime, action):
                for _ in range(80):
                    if not ipc(executable, runtime, "status"):
                        return 0
                    time.sleep(0.05)
                raise RuntimeError("Caelestia settings did not close")
            if action == "close":
                return 0
            subprocess.run([str(Path(__file__).with_name("kona-upstream-theme"))], check=True)
            wallpaper_state = Path.home() / ".local/state/caelestia/wallpaper/path.txt"
            if not wallpaper_state.is_file() or not wallpaper_state.read_text(encoding="utf-8").strip():
                wallpaper_state.parent.mkdir(parents=True, exist_ok=True)
                wallpaper_state.write_text(
                    str(Path.home() / ".local/share/wallpapers/konata-command-center/v2/selected.png") + "\n",
                    encoding="utf-8",
                )
            log = Path.home() / ".local/state/kona/caelestia-settings.log"
            log.parent.mkdir(parents=True, exist_ok=True)
            child = subprocess.Popen(
                [executable, "-n", "-p", str(runtime), "--no-color"],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=log.open("ab"),
                env={**os.environ, "CAELESTIA_WALLPAPERS_DIR": str(Path.home() / ".local/share/wallpapers")},
            )
            for _ in range(80):
                if ipc(executable, runtime, "status"):
                    return 0
                if child.poll() is not None:
                    raise RuntimeError("Caelestia settings exited before becoming ready")
                time.sleep(0.05)
            raise RuntimeError("Caelestia settings did not become ready")
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"kona-caelestia-settings: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
