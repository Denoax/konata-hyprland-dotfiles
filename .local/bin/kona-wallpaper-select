#!/usr/bin/env python3
"""Apply a still wallpaper selected by transient upstream UI through Kona."""

from __future__ import annotations

import os
from pathlib import Path
import random
import subprocess
import sys


HOME = Path.home()
PROFILE = HOME / ".local/bin/kona-profile"
SOUND = HOME / ".local/bin/kona-menu-sound"
WALLPAPER_ROOTS = (
    HOME / ".local/share/wallpapers",
    HOME / "Pictures/Wallpapers",
)
IMAGE_SUFFIXES = {".avif", ".gif", ".jpeg", ".jpg", ".png", ".webp"}


def run(args: list[os.PathLike[str] | str]) -> None:
    subprocess.run([str(value) for value in args], check=True)


def images() -> list[Path]:
    candidates: list[Path] = []
    for root in WALLPAPER_ROOTS:
        if not root.is_dir():
            continue
        candidates.extend(
            path for path in root.rglob("*")
            if path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES
        )
    return sorted(set(candidates))


def select(argument: str) -> Path:
    if argument == "--random":
        candidates = images()
        if not candidates:
            raise RuntimeError("no local wallpapers are available")
        return random.SystemRandom().choice(candidates)
    path = Path(argument).expanduser().resolve(strict=True)
    if not path.is_file() or path.suffix.lower() not in IMAGE_SUFFIXES:
        raise RuntimeError(f"unsupported wallpaper: {path}")
    return path


def main() -> int:
    try:
        if len(sys.argv) != 2:
            raise RuntimeError("usage: kona-wallpaper-select {IMAGE|--random}")
        wallpaper = select(sys.argv[1])
        run([PROFILE, "preview", wallpaper])
        try:
            run([PROFILE, "preview-apply"])
        except Exception:
            run([PROFILE, "preview-revert"])
            raise
        if SOUND.is_file() and os.access(SOUND, os.X_OK):
            subprocess.Popen([str(SOUND)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"kona-wallpaper-select: {error}", file=sys.stderr)
        subprocess.run([
            "notify-send", "-u", "critical", "Wallpaper was not changed", str(error)
        ], check=False)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
