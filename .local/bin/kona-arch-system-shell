#!/usr/bin/env bash
set -uo pipefail

config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
fastfetch --config "$config_root/fastfetch/kona-arch.jsonc"

count_lines() {
    local output
    if output=$("$@" 2>/dev/null); then
        if [[ -z "$output" ]]; then
            printf '0'
        else
            sed '/^[[:space:]]*$/d' <<<"$output" | wc -l
        fi
    else
        printf 'unavailable'
    fi
}

packages="$(count_lines pacman -Qq)"
explicit="$(count_lines pacman -Qqe)"
failed_system="$(count_lines systemctl --failed --no-legend --plain)"
failed_user="$(count_lines systemctl --user --failed --no-legend --plain)"
profile="$($HOME/.local/bin/kona-profile status 2>/dev/null | jq -r '.profile // "unknown"' 2>/dev/null || printf 'unknown')"
displays="$(hyprctl monitors -j 2>/dev/null | jq -r '[.[].width | tostring] as $w | [.[].height | tostring] as $h | if length == 0 then "unknown" elif ($w | unique | length) == 1 and ($h | unique | length) == 1 then "\($w[0])x\($h[0]) × \(length)" else [ .[] | "\(.width)x\(.height)" ] | join(" · ") end' 2>/dev/null || printf 'unknown')"

printf '\033[1;34mARCH STATE\033[0m  %s installed / %s explicit\n' "$packages" "$explicit"
printf 'failed units   %s system / %s user\n' "$failed_system" "$failed_user"
printf 'desktop        %s · %s profile\n\n' "$displays" "$profile"

if [[ -x "$HOME/.local/bin/kona-scratch-shell" ]]; then
    exec "$HOME/.local/bin/kona-scratch-shell" terminal
fi
exec "${SHELL:-/bin/bash}" -l
