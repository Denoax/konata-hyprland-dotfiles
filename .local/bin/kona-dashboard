#!/usr/bin/env bash
set -euo pipefail

# Compatibility entrypoint used by Super+Shift+Return and Super+Ctrl+D.
# SwayNC remains the single notification and command-center owner. This
# one-shot preparation only renders presentation data that SwayNC cannot
# calculate itself; it creates no process or state owner.
action="${1:---open}"
case "$action" in
  --open|--toggle|--sync-only) ;;
  *)
    printf 'usage: %s [--open|--toggle|--sync-only]\n' "$0" >&2
    exit 2
    ;;
esac

config="$HOME/.config/swaync/config.json"
assets="$HOME/.config/swaync/assets"
appearance="$HOME/.config/kona/appearance/current.json"

mode="$(jq -er '.mode | select(. == "light" or . == "dark")' "$appearance")"
current="$(readlink "$assets/current" 2>/dev/null || true)"
asset_changed=false
if [[ "$current" != "$mode" ]]; then
  next="$assets/.current-next"
  [[ ! -e "$next" && ! -L "$next" ]] || unlink "$next"
  ln -s "$mode" "$next"
  mv -Tf "$next" "$assets/current"
  asset_changed=true
fi

count="$(swaync-client --count --skip-wait)"
[[ "$count" =~ ^[0-9]+$ ]] || {
  printf 'kona-dashboard: invalid SwayNC notification count: %s\n' "$count" >&2
  exit 1
}

config_changed="$(python3 - "$config" "$count" "$mode" <<'PY'
import datetime
import json
import os
from pathlib import Path
import sys
import tempfile

path = Path(sys.argv[1])
count = int(sys.argv[2])
mode = sys.argv[3]
data = json.loads(path.read_text())
widgets = data["widget-config"]
now = datetime.datetime.now().astimezone()
desired = {
    ("label#clock", "text"): now.strftime("%H:%M"),
    ("label#date", "text"): now.strftime("%a, %b %-d"),
    ("label#speech", "text"): (
        "Stay in the loop, oniichan!" if mode == "light" else "Still procrastinating?"
    ),
    ("title", "text"): f"Notifications       {count} new",
}
changed = False
for (widget, field), value in desired.items():
    if widgets[widget].get(field) != value:
        widgets[widget][field] = value
        changed = True
if changed:
    descriptor, temporary = tempfile.mkstemp(prefix=".config.", suffix=".json", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(data, stream, indent=2, ensure_ascii=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)
print("true" if changed else "false")
PY
)"

if [[ "$config_changed" == true ]]; then
  swaync-client --reload-config --skip-wait
fi
if [[ "$asset_changed" == true ]]; then
  swaync-client --reload-css --skip-wait
fi

[[ "$action" != --sync-only ]] || exit 0
"$HOME/.local/bin/kona-menu-sound"
if [[ "$action" == --toggle ]]; then
  exec swaync-client --toggle-panel --skip-wait
fi
exec swaync-client --open-panel --skip-wait
