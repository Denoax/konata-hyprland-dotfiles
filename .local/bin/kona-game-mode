#!/usr/bin/env bash
set -euo pipefail
# Compatibility facade: profile owns mutations; existing marker is its runtime projection.
state_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kona-game-mode"
case "${1:-toggle}" in
  toggle|on|off) exec "$HOME/.local/bin/kona-profile" gaming "${1:-toggle}" ;;
  reconcile) exec "$HOME/.local/bin/kona-profile" reconcile ;;
  status) [[ -f "$state_file" ]] && printf 'on\n' || printf 'off\n' ;;
  waybar)
    if [[ -f "$state_file" ]]; then
      jq -cn '{text:"󰊴 GAME",tooltip:"Gaming mode is active\nClick to restore desktop effects",class:"active"}'
    else
      jq -cn '{text:"",tooltip:"Enable gaming mode",class:"inactive"}'
    fi
    ;;
  *) printf 'usage: %s {toggle|on|off|status|waybar|reconcile}\n' "$0" >&2; exit 2 ;;
esac
