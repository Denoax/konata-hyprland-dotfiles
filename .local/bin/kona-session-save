#!/usr/bin/env bash
set -euo pipefail

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/kona"
session_file="$state_root/session.json"
mkdir -p "$state_root"
case "${1:-}" in
  --initialize) touch "$state_root/session-restore-enabled"; exit 0 ;;
  ''|--quiet) ;;
  *) printf 'usage: %s [--quiet|--initialize]\n' "$0" >&2; exit 2 ;;
esac

# Manual, event and restore workers share this lock. Failed queries preserve
# the last usable session; identical snapshots do not churn storage.
exec 9>"$state_root/session.lock"
flock -w 10 9 || exit 1
temporary="$(mktemp "$state_root/.session.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

timeout 5 hyprctl clients -j | jq -e '
  if type != "array" then error("Hyprland clients response is not an array") else . end |
  def command_for:
    (.class | ascii_downcase) as $class |
    if $class == "brave-browser" then ["flatpak", "run", "com.brave.Browser"]
    elif $class == "code" then ["flatpak", "run", "com.visualstudio.code"]
    elif $class == "spotify" then ["flatpak", "run", "com.spotify.Client"]
    elif $class == "discord" then ["flatpak", "run", "com.discordapp.Discord"]
    elif $class == "slack" then ["flatpak", "run", "com.slack.Slack"]
    elif $class == "org.telegram.desktop" then ["flatpak", "run", "org.telegram.desktop"]
    elif $class == "steam" then ["flatpak", "run", "com.valvesoftware.Steam"]
    elif $class == "kitty" then ["kitty"]
    else null end;
  [ .[] |
    select(.mapped == true and .initialClass != "KonaDashboard") |
    (command_for) as $command |
    select($command != null) |
    {
      class: .class,
      command: $command,
      workspace: (if .workspace.id > 0 then .workspace.id else 2 end),
      floating: .floating,
      fullscreen: .fullscreen,
      x: .at[0],
      y: .at[1],
      width: .size[0],
      height: .size[1]
    }
  ] |
  unique_by(.class)
' > "$temporary"

if ! cmp -s "$temporary" "$session_file"; then
  mv "$temporary" "$session_file"
fi
if [[ "${1:-}" != "--quiet" ]]; then
  count="$(jq 'length' "$session_file")"
  notify-send -a 'Kona Session' 'Session saved' "$count restorable apps remembered."
fi
