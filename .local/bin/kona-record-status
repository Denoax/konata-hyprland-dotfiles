#!/usr/bin/env bash
set -euo pipefail

state_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kona-record"
pid_file="$state_root/pid"
start_file="$state_root/started"

if [[ -s "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
  started="$(cat "$start_file" 2>/dev/null || date +%s)"
  elapsed=$(( $(date +%s) - started ))
  printf -v clock '%02d:%02d' $((elapsed / 60)) $((elapsed % 60))
  jq -cn --arg text "● $clock" --arg tooltip 'Screen recording active\nClick to stop and save' \
    '{text:$text,tooltip:$tooltip,class:"recording"}'
else
  jq -cn '{text:"",tooltip:"Start an active-monitor recording",class:"idle"}'
fi
