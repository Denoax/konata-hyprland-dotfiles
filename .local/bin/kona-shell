#!/usr/bin/env python3
"""One on-demand Kona surface, with bounded startup and owner cleanup on exit."""
import fcntl
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time

home=Path.home()
page=sys.argv[1] if len(sys.argv)>1 else 'deck'
if page not in ('deck','studio','wallpapers','shortcuts','mosaic','close'):sys.exit('Unknown Kona surface')
config=Path(os.environ.get('KONA_SHELL_CONFIG',home/'.config/quickshell/kona'))
packages=(home/'.local/opt/kona-pkgs/quickshell/usr',home/'.local/opt/kona-pkgs/quickshell-0.3.1/usr')
pkg=next((path for path in packages if (path/'bin/quickshell').is_file()),packages[0])
exe=shutil.which('quickshell') or str(pkg/'bin/quickshell')
if not Path(exe).is_file():
    fallback='kona-wallpaper-menu' if page=='wallpapers' else 'kona-quick-settings'
    subprocess.run(['notify-send','Kona','Optional Quickshell is unavailable; opening the Rofi fallback.'])
    os.execv(str(home/'.local/bin'/fallback),[fallback])
env=os.environ.copy()
if exe.startswith(str(pkg)):
    env.update(LD_LIBRARY_PATH=str(pkg/'lib')+(':'+env['LD_LIBRARY_PATH'] if env.get('LD_LIBRARY_PATH') else ''),
               QML_IMPORT_PATH=str(pkg/'lib/qt6/qml'),QT_PLUGIN_PATH=str(pkg/'lib/qt6/plugins'))
env['KONA_SURFACE']=page
env['QT_LINUX_ACCESSIBILITY_ALWAYS_ON']='1'
env['KONA_SURFACE_HELPER']=os.environ.get('KONA_SURFACE_HELPER',str(home/'.local/bin/kona-surface-data'))
runtime=Path(env.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))/'kona';runtime.mkdir(exist_ok=True)
with (runtime/'surface.lock').open('w') as lock:
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:
        # Existing entering/leaving surface reverses through its own progress state.
        for _ in range(30):
            p=subprocess.run([exe,'ipc','-p',str(config),'call','surface','activate',page],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            if p.returncode==0:sys.exit(0)
            time.sleep(.05)
        sys.exit('Kona surface is still starting; try again')
    if page=='close':sys.exit(0)
    owner=home/'.local/bin/kona-profile'
    previous=None
    if page=='mosaic':
        previous=True
        subprocess.run([str(owner),'mosaic-start'],check=True)
    log=Path(env.get('XDG_STATE_HOME',home/'.local/state'))/'kona/surface.log';log.parent.mkdir(parents=True,exist_ok=True)
    child=None
    def interrupted(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM,interrupted)
    signal.signal(signal.SIGINT,interrupted)
    try:
        with log.open('a') as out:
            child=subprocess.Popen([exe,'-n','-p',str(config),'--no-color'],env=env,stdout=out,stderr=subprocess.STDOUT,start_new_session=True)
            result=child.wait()
    except KeyboardInterrupt:
        result=130
    finally:
        # Own the complete UI process group, including native subscriptions. User
        # applications opened by the adapter deliberately start separate sessions.
        if child is not None:
            try:os.killpg(child.pid,signal.SIGTERM)
            except ProcessLookupError:pass
        if child is not None and child.poll() is None:
            child.terminate()
            child.wait(timeout=8)
        subprocess.run([str(owner),'preview-revert'],stdout=subprocess.DEVNULL)
        subprocess.run([str(home/'.local/bin/kona-appearance'),'revert'],stdout=subprocess.DEVNULL)
        subprocess.run([str(owner),'mosaic-end'])
    sys.exit(result)
