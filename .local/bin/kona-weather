#!/usr/bin/env python3
"""Fetch and cache explicit-location weather data without a resident service."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import tempfile
import time
from urllib.parse import urlencode
from urllib.request import Request, urlopen


HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "kona/weather.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "kona/weather.json"
ENDPOINT = "https://api.open-meteo.com/v1/forecast"
DEFAULT_TTL = 1800


class ConfigError(ValueError):
    pass


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError, json.JSONDecodeError):
        return default


def atomic(path: Path, value: dict) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def load_config(path: Path = CONFIG) -> dict:
    value = read_json(path)
    if not isinstance(value, dict):
        raise ConfigError(f"Create {path} from ~/.config/kona/weather.example.json")
    if value.get("schema") != 1:
        raise ConfigError("weather config schema must be 1")
    name = " ".join(str(value.get("name", "")).split())
    region = " ".join(str(value.get("region", "")).split())
    latitude = value.get("latitude")
    longitude = value.get("longitude")
    units = value.get("units", "metric")
    ttl = value.get("refresh_minutes", 30)
    if not name or len(name) > 80:
        raise ConfigError("weather location name must contain 1–80 characters")
    if type(latitude) not in (int, float) or not -90 <= latitude <= 90:
        raise ConfigError("weather latitude must be between -90 and 90")
    if type(longitude) not in (int, float) or not -180 <= longitude <= 180:
        raise ConfigError("weather longitude must be between -180 and 180")
    if units not in ("metric", "imperial"):
        raise ConfigError("weather units must be metric or imperial")
    if type(ttl) not in (int, float) or not 15 <= ttl <= 120:
        raise ConfigError("weather refresh_minutes must be between 15 and 120")
    return {"schema": 1, "name": name, "region": region, "latitude": float(latitude),
            "longitude": float(longitude), "units": units, "refresh_minutes": int(ttl)}


def config_key(config: dict) -> str:
    selected = {key: config[key] for key in ("name", "region", "latitude", "longitude", "units")}
    return hashlib.sha256(json.dumps(selected, sort_keys=True).encode()).hexdigest()[:16]


def condition(code: int) -> str:
    if code == 0:
        return "Clear"
    if code in (1, 2):
        return "Partly cloudy"
    if code == 3:
        return "Overcast"
    if code in (45, 48):
        return "Fog"
    if code in (51, 53, 55, 56, 57):
        return "Drizzle"
    if code in (61, 63, 65, 66, 67, 80, 81, 82):
        return "Rain"
    if code in (71, 73, 75, 77, 85, 86):
        return "Snow"
    if code in (95, 96, 99):
        return "Thunderstorm"
    return "Unsettled"


def compass(degrees: float) -> str:
    points = ("N", "NE", "E", "SE", "S", "SW", "W", "NW")
    return points[int((float(degrees) + 22.5) // 45) % 8]


def request_url(config: dict) -> str:
    query = {
        "latitude": config["latitude"], "longitude": config["longitude"],
        "current": "temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m,wind_direction_10m,precipitation",
        "hourly": "temperature_2m,weather_code,precipitation_probability",
        "daily": "temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code",
        "timezone": "auto", "forecast_days": 2,
    }
    if config["units"] == "imperial":
        query.update(temperature_unit="fahrenheit", wind_speed_unit="mph", precipitation_unit="inch")
    return ENDPOINT + "?" + urlencode(query)


def number(value, name: str) -> float:
    if type(value) not in (int, float):
        raise ValueError(f"weather response has invalid {name}")
    return float(value)


def normalize(raw: dict, config: dict, fetched_at: int) -> dict:
    current = raw.get("current")
    hourly = raw.get("hourly")
    daily = raw.get("daily")
    if not all(isinstance(value, dict) for value in (current, hourly, daily)):
        raise ValueError("weather response is missing current/hourly/daily data")
    times = hourly.get("time")
    temperatures = hourly.get("temperature_2m")
    codes = hourly.get("weather_code")
    chances = hourly.get("precipitation_probability")
    if not all(isinstance(value, list) for value in (times, temperatures, codes, chances)):
        raise ValueError("weather response hourly data is invalid")
    start = next((index for index, value in enumerate(times) if str(value) >= str(current.get("time", ""))), 0)
    forecast = []
    for index in range(start, min(len(times), start + 16), 3):
        if index >= min(len(temperatures), len(codes), len(chances)):
            break
        code = int(number(codes[index], "hourly weather code"))
        forecast.append({"time": str(times[index]), "temperature": round(number(temperatures[index], "hourly temperature")),
                         "code": code, "condition": condition(code),
                         "precipitation_chance": round(number(chances[index], "hourly precipitation chance"))})
    code = int(number(current.get("weather_code"), "weather code"))
    unit_temp = "°F" if config["units"] == "imperial" else "°C"
    unit_wind = "mph" if config["units"] == "imperial" else "km/h"
    unit_precip = "in" if config["units"] == "imperial" else "mm"
    return {
        "schema": 1, "status": "ok", "source": "Open-Meteo", "fetched_at": fetched_at,
        "config_key": config_key(config),
        "location": {"name": config["name"], "region": config["region"]},
        "units": {"temperature": unit_temp, "wind": unit_wind, "precipitation": unit_precip},
        "current": {
            "time": str(current.get("time", "")),
            "temperature": round(number(current.get("temperature_2m"), "temperature")),
            "feels_like": round(number(current.get("apparent_temperature"), "apparent temperature")),
            "humidity": round(number(current.get("relative_humidity_2m"), "humidity")),
            "wind_speed": round(number(current.get("wind_speed_10m"), "wind speed")),
            "wind_direction": compass(number(current.get("wind_direction_10m"), "wind direction")),
            "precipitation": number(current.get("precipitation"), "precipitation"),
            "precipitation_chance": round(number(daily.get("precipitation_probability_max", [0])[0], "precipitation chance")),
            "code": code, "condition": condition(code),
            "high": round(number(daily.get("temperature_2m_max", [None])[0], "daily high")),
            "low": round(number(daily.get("temperature_2m_min", [None])[0], "daily low")),
        },
        "hourly": forecast,
    }


def fetch(config: dict, opener=urlopen, now: int | None = None) -> dict:
    request = Request(request_url(config), headers={"User-Agent": "Kona-Desktop/1 weather"})
    with opener(request, timeout=8) as response:
        payload = json.loads(response.read().decode("utf-8"))
    return normalize(payload, config, int(time.time() if now is None else now))


def status(force=False, config_path: Path = CONFIG, cache_path: Path = CACHE,
           opener=urlopen, now: int | None = None) -> dict:
    instant = int(time.time() if now is None else now)
    try:
        config = load_config(config_path)
    except ConfigError as error:
        return {"schema": 1, "status": "setup", "message": str(error), "config_path": str(config_path)}
    cached = read_json(cache_path)
    valid_cache = (isinstance(cached, dict) and cached.get("schema") == 1 and
                   cached.get("config_key") == config_key(config) and isinstance(cached.get("fetched_at"), int))
    age = instant - cached["fetched_at"] if valid_cache else None
    ttl = config["refresh_minutes"] * 60
    if not force and valid_cache and 0 <= age < ttl:
        return {**cached, "status": "ok", "cached": True, "stale": False, "age_seconds": age}
    try:
        fresh = fetch(config, opener=opener, now=instant)
        atomic(cache_path, fresh)
        return {**fresh, "cached": False, "stale": False, "age_seconds": 0}
    except Exception as error:
        if valid_cache:
            return {**cached, "status": "stale", "cached": True, "stale": True,
                    "age_seconds": max(0, age), "error": str(error)}
        return {"schema": 1, "status": "error", "location": {"name": config["name"], "region": config["region"]},
                "message": "Weather data is unavailable", "error": str(error), "config_path": str(config_path)}


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("status", "refresh", "config-path"), nargs="?", default="status")
    arguments = parser.parse_args()
    if arguments.action == "config-path":
        print(CONFIG)
        return
    print(json.dumps(status(force=arguments.action == "refresh"), separators=(",", ":")))


if __name__ == "__main__":
    main()
