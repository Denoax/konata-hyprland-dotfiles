#!/usr/bin/env bash
set -euo pipefail

commit_snapshot=true
push_snapshot=false
for option in "$@"; do
  case "$option" in
    --no-commit) commit_snapshot=false ;;
    --push) push_snapshot=true ;;
    --help|-h)
      printf 'usage: %s [--no-commit] [--push]\n' "$0"
      printf 'Sync tracked Kona files from $HOME; commit locally by default.\n'
      exit 0
      ;;
    *) printf 'unknown option: %s\n' "$option" >&2; exit 2 ;;
  esac
done

repo_hint="${XDG_CONFIG_HOME:-$HOME/.config}/kona/backup-repo"
if [[ -n "${KONA_DOTFILES_ROOT:-}" ]]; then
  repo_root="$KONA_DOTFILES_ROOT"
elif [[ -s "$repo_hint" ]]; then
  repo_root="$(cat "$repo_hint")"
else
  printf 'Kona repository is not configured. Set KONA_DOTFILES_ROOT or reinstall from a clone.\n' >&2
  exit 1
fi

git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  printf 'Not a Git working tree: %s\n' "$repo_root" >&2
  exit 1
}

if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
  printf 'Repository already has changes; refusing to mix them into an automatic checkpoint.\n' >&2
  printf 'Review %s, then rerun kona-backup.\n' "$repo_root" >&2
  exit 1
fi

missing=0
while IFS= read -r -d '' relative; do
  [[ "$relative" != '.config/kona/theme/current' ]] || continue
  source="$HOME/$relative"
  destination="$repo_root/$relative"
  if [[ ! -e "$source" && ! -L "$source" ]]; then
    printf 'Skipping absent live path: %s\n' "$relative" >&2
    missing=$((missing + 1))
    continue
  fi
  mkdir -p "$(dirname "$destination")"
  rsync -a -- "$source" "$destination"
done < <(git -C "$repo_root" ls-files -z -- .config .local/bin .local/share)

if git -C "$repo_root" diff --quiet -- .config .local/bin .local/share; then
  notify-send -a 'Kona Backup' 'No changes' 'Tracked Kona files already match the repository.' 2>/dev/null || true
  printf 'Tracked Kona files already match %s.\n' "$repo_root"
  exit 0
fi

git -C "$repo_root" diff --check
if [[ "$commit_snapshot" == false ]]; then
  printf 'Synced tracked Kona files into %s; changes are uncommitted.\n' "$repo_root"
  exit 0
fi

git -C "$repo_root" add --update -- .config .local/bin .local/share
git -C "$repo_root" commit -m "chore: checkpoint Kona desktop $(date +%Y-%m-%d)"

if [[ "$push_snapshot" == true ]]; then
  git -C "$repo_root" remote get-url origin >/dev/null 2>&1 || {
    printf 'No origin remote is configured; local checkpoint was retained.\n' >&2
    exit 1
  }
  git -C "$repo_root" push origin HEAD
fi

message='Local checkpoint created.'
[[ "$push_snapshot" == false ]] || message='Local checkpoint created and pushed.'
notify-send -a 'Kona Backup' 'Backup complete' "$message" 2>/dev/null || true
printf '%s Missing live paths: %s\n' "$message" "$missing"
