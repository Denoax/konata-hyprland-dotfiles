#!/usr/bin/env python3
"""Single-instance host for Kona's primary sidebar navigation surface."""
import fcntl
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'toggle'
    if action not in ('toggle', 'show', 'close', 'expand', 'collapse', 'mute', 'unmute', 'gain'):
        raise ValueError('usage: kona-sidebar [toggle|show|close|expand|collapse|mute|unmute|gain 0..0.5]')
    if len(sys.argv) > (3 if action == 'gain' else 2) or (action == 'gain' and (len(sys.argv) != 3 or not 0 <= float(sys.argv[2]) <= 0.5)):
        raise ValueError('gain requires a number from 0 to 0.5; other actions take no argument')
    home = Path.home()
    config = Path(os.environ.get('KONA_SIDEBAR_CONFIG', home / '.config/quickshell/kona/sidebar'))
    package = home / '.local/opt/kona-pkgs/quickshell-0.3.1/usr'
    executable = shutil.which('quickshell') or str(package / 'bin/quickshell')
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'kona'
    runtime.mkdir(exist_ok=True)
    with (runtime / 'sidebar.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            existing = False
        except BlockingIOError:
            existing = True
        if not existing and action == 'close':
            return 0
        if not existing and action in ('mute', 'unmute', 'gain'):
            raise RuntimeError('Open the sidebar before changing its preferences')
        if not Path(executable).is_file():
            raise RuntimeError('Optional Quickshell is unavailable; sidebar was not started')
        env = os.environ.copy()
        if executable.startswith(str(package)):
            env.update(LD_LIBRARY_PATH=str(package / 'lib'), QML_IMPORT_PATH=str(package / 'lib/qt6/qml'),
                       QT_PLUGIN_PATH=str(package / 'lib/qt6/plugins'))
        env['QT_LINUX_ACCESSIBILITY_ALWAYS_ON'] = '1'
        state = Path(env.get('KONA_SIDEBAR_STATE', Path(env.get('XDG_STATE_HOME', home / '.local/state')) / 'kona/sidebar.ini'))
        state.parent.mkdir(parents=True, exist_ok=True)
        env['KONA_SIDEBAR_STATE'] = str(state)
        env['KONA_SIDEBAR_INITIAL'] = action
        if existing:
            for _ in range(30):
                result = subprocess.run([executable, 'ipc', '-p', str(config), 'call', 'sidebar', action] + (sys.argv[2:] if action == 'gain' else []),
                                        env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                if result.returncode == 0:
                    return 0
                time.sleep(.05)
            raise RuntimeError('Sidebar is still starting; try again')
        log = Path(env.get('XDG_STATE_HOME', home / '.local/state')) / 'kona/sidebar.log'
        log.parent.mkdir(parents=True, exist_ok=True)
        def interrupt(signum, frame):
            raise KeyboardInterrupt
        signal.signal(signal.SIGTERM, interrupt)
        signal.signal(signal.SIGINT, interrupt)
        child = None
        try:
            with log.open('a') as output:
                child = subprocess.Popen([executable, '-n', '-p', str(config), '--no-color'],
                                         env=env, stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
                return child.wait()
        except KeyboardInterrupt:
            return 130
        finally:
            if child is not None:
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                try:
                    child.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'kona-sidebar: {error}', file=sys.stderr)
        sys.exit(1)
