#!/usr/bin/env python3
"""Single-instance host for Kona's transient weather surface."""

import fcntl
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if action not in ("toggle", "close", "refresh") or len(sys.argv) > 2:
        raise ValueError("usage: kona-weather-popup [toggle|close|refresh]")
    home = Path.home()
    config = Path(os.environ.get("KONA_WEATHER_CONFIG", home / ".config/quickshell/kona/weather"))
    packages = (home / ".local/opt/kona-pkgs/quickshell/usr",
                home / ".local/opt/kona-pkgs/quickshell-0.3.1/usr")
    package = next((path for path in packages if (path / "bin/quickshell").is_file()), packages[0])
    executable = shutil.which("quickshell") or str(package / "bin/quickshell")
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "kona"
    runtime.mkdir(exist_ok=True)
    with (runtime / "weather-popup.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            existing = False
        except BlockingIOError:
            existing = True
        if not existing and action == "close":
            return 0
        if not Path(executable).is_file():
            raise RuntimeError("Optional Quickshell is unavailable")
        env = os.environ.copy()
        if executable.startswith(str(package)):
            env.update(LD_LIBRARY_PATH=str(package / "lib"), QML_IMPORT_PATH=str(package / "lib/qt6/qml"),
                       QT_PLUGIN_PATH=str(package / "lib/qt6/plugins"))
        env["QT_LINUX_ACCESSIBILITY_ALWAYS_ON"] = "1"
        if existing:
            for _ in range(30):
                result = subprocess.run([executable, "ipc", "-p", str(config), "call", "weather", action],
                                        env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                if result.returncode == 0:
                    return 0
                time.sleep(.05)
            raise RuntimeError("Weather surface is still starting; try again")
        log = Path(env.get("XDG_STATE_HOME", home / ".local/state")) / "kona/weather-popup.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        def interrupt(signum, frame):
            raise KeyboardInterrupt
        signal.signal(signal.SIGTERM, interrupt)
        signal.signal(signal.SIGINT, interrupt)
        child = None
        try:
            with log.open("a") as output:
                child = subprocess.Popen([executable, "-n", "-p", str(config), "--no-color"],
                                         env=env, stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
                return child.wait()
        except KeyboardInterrupt:
            return 130
        finally:
            if child is not None:
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                try:
                    child.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"kona-weather-popup: {error}", file=sys.stderr)
        sys.exit(1)
