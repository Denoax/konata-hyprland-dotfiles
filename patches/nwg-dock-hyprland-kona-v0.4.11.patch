index 7345189..9a8b7bf 100644
--- a/hypr.go
+++ b/hypr.go
@@ -139,6 +139,25 @@ func dispatch(luaCmd string, legacyCmd string) {
 }
 
 func focusWindow(address string) {
+	for _, window := range clients {
+		if window.Address != address || window.Workspace.Name != "special:minimized" {
+			continue
+		}
+
+		var activeWorkspace workspace
+		reply, err := hyprctl("j/activeworkspace")
+		if err == nil && json.Unmarshal(reply, &activeWorkspace) == nil && activeWorkspace.Name != "" {
+			lua := fmt.Sprintf("dispatch hl.dsp.window.move({ workspace = '%s', follow = false, window = 'address:%s' })", activeWorkspace.Name, address)
+			legacy := fmt.Sprintf("dispatch movetoworkspacesilent %s,address:%s", activeWorkspace.Name, address)
+			dispatch(lua, legacy)
+			dispatch(
+				fmt.Sprintf("dispatch hl.dsp.window.clear_tags({ window = 'address:%s' })", address),
+				fmt.Sprintf("dispatch tagwindow -- -minimized,address:%s", address),
+			)
+		}
+		break
+	}
+
 	lua := fmt.Sprintf("dispatch hl.dsp.focus({ window = 'address:%s' })", address)
 	legacy := fmt.Sprintf("dispatch focuswindow address:%s ", address)
 	dispatch(lua, legacy)
