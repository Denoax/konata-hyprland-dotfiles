/* Generated by kona-theme; geometry lives in shared.rasi. */
* {
  bg: #111B2Bf7;
  bg-alt: #162338;
  bg-elevated: #1B2A42;
  bg-pressed: #223550;
  fg: #EAF2FF;
  muted: #B6C4D9;
  faint: #8393AA;
  placeholder-text: #B6C4D9;
  accent: #7FAEFF;
  accent-text: #6B9CF2;
  accent-hover: #94BCFF;
  accent-soft: #203A63;
  outline: #294263;
  outline-strong: #3B5B84;
  danger: #FF7C88;
  danger-text: #FF7C88;
  warning: #E7B05A;
  success: #43D5A0;
  cyan: #7FAEFF;
  sky: #94BCFF;
  selected-fg: #0B1220;
  input-line: rgba(138, 182, 255, 0.35);
}
