/* Generated by kona-theme; geometry lives in shared.rasi. */
* {
  bg: #171D29f7;
  bg-alt: #202A3A;
  bg-elevated: #293548;
  bg-pressed: #33425A;
  fg: #F7FAFF;
  muted: #D6E3F5;
  faint: #9EACC0;
  placeholder-text: #D6E3F5;
  accent: #8EB8FF;
  accent-text: #7AA8F8;
  accent-hover: #A9C8FF;
  accent-soft: #2D405E;
  outline: #4D6380;
  outline-strong: #6E8CAD;
  danger: #FF91A4;
  danger-text: #FF91A4;
  warning: #F2C879;
  success: #72DCB2;
  cyan: #8EB8FF;
  sky: #A9C8FF;
  selected-fg: #10141C;
  input-line: rgba(181, 210, 255, 0.35);
}
